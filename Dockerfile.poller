# Linkwatch remote poller (runs on your LAN; outbound HTTPS only)
FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 LW_DATA_DIR=/var/lib/linkwatch
# ping gets cap_net_raw as *permitted* only (not effective): with --cap-add=NET_RAW it opens raw ICMP sockets,
# without it it still starts and falls back to ICMP datagram sockets (net.ipv4.ping_group_range).
# mtr-packet (path probes) needs cap_net_raw effective, so path probes need --cap-add=NET_RAW.
RUN apt-get update && apt-get install -y --no-install-recommends iputils-ping mtr-tiny libcap2-bin \
 && setcap cap_net_raw+p /usr/bin/ping && setcap cap_net_raw+ep /usr/bin/mtr-packet \
 && apt-get purge -y libcap2-bin && rm -rf /var/lib/apt/lists/*
WORKDIR /srv
COPY linkwatch/requirements-poller.txt ./
RUN pip install --no-cache-dir -r requirements-poller.txt
COPY linkwatch/__init__.py linkwatch/__init__.py
COPY linkwatch/common linkwatch/common
COPY linkwatch/integrations linkwatch/integrations
COPY linkwatch/poller linkwatch/poller
RUN useradd --create-home --uid 10001 linkwatch && mkdir -p /var/lib/linkwatch && chown linkwatch /var/lib/linkwatch
USER linkwatch
VOLUME ["/var/lib/linkwatch"]
# The build id the poller reports to the server (CI passes sha-<commit>), so an update can be verified.
# Last, so a new id doesn't invalidate the cached layers above.
ARG LW_BUILD=dev
ENV LW_BUILD=${LW_BUILD}
CMD ["python", "-m", "linkwatch.poller"]
