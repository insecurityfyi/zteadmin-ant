# VisCon1 web server (runs on the VPS)
FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /srv
COPY linkwatch/requirements-server.txt linkwatch/requirements-poller.txt ./
RUN pip install --no-cache-dir -r requirements-server.txt -r requirements-poller.txt
COPY linkwatch ./linkwatch
RUN useradd --create-home --uid 10001 linkwatch
USER linkwatch
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8080/healthz',timeout=4).status==200 else 1)"
CMD ["uvicorn", "--factory", "linkwatch.server.app:create_app", "--host", "0.0.0.0", "--port", "8080", "--proxy-headers", "--forwarded-allow-ips", "*"]
