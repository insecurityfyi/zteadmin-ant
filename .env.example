# Key used to encrypt API secrets at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, a key is generated on first start and stored in the data volume.
TOOLBOX_SECRET_KEY=

# Optional HTTP basic auth for the web UI (user "admin"). Strongly recommended
# if the port is reachable by anyone but you.
TOOLBOX_PASSWORD=

# Show sample data until a ZIA tenant is connected (1 = on, 0 = off).
TOOLBOX_DEMO=1

# Minutes between background syncs with ZIA.
TOOLBOX_SYNC_MINUTES=60
